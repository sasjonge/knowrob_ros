<?xml version="1.0"?>
<package format="2">
  <name>knowrob_ros</name>
  <version>2.0.0</version>
  <description>
    knowrob_ros is a ros wrapper around KnowRob, a knowledge processing framework 
    for robots. It is currently maintained by Daniel Beßler at the AICOR group in Bremen, Germany.
  </description>

  <maintainer email="jongebloed@uni-bremen.de">Sascha Jongebloed</maintainer>
  <author>Daniel Beßler</author>

  <license>BSD</license>

  <url type="website">http://www.knowrob.org</url>
  <url type="bugtracker">https://github.com/knowrob/knowrob/issues</url>

  <!-- Ament build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- ROSIDL generators for messages / services / actions -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Build-time dependencies -->
  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>action_msgs</build_depend>
  <build_depend>knowrob</build_depend>
  <build_depend>spdlog</build_depend>

  <!-- Runtime dependencies -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>knowrob</exec_depend>
  <exec_depend>spdlog</exec_depend>
  <!-- ROSIDL runtime support -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Optional: if you still ship Python scripts, add this or switch to ament_python -->
  <!--
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  -->

  <!-- Testing (use ament_lint_auto, ament_cmake_gtest, or ament_pytest) -->
  <!--
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  -->
</package>
